<?xml version="1.0"?>
<!-- A primitive-only 2-DOF arm. No mesh files, so it renders out of the box and
     proves the URDF load + joint-control pipeline. Replace by loading a real
     URDF (with meshes) to see an actual robot. -->
<robot name="simple_arm">
  <material name="gray"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="blue"><color rgba="0.22 0.45 0.92 1"/></material>
  <material name="orange"><color rgba="0.95 0.52 0.12 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.10" length="0.08"/></geometry>
      <material name="gray"/>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.20"/>
      <geometry><box size="0.06 0.06 0.40"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><box size="0.05 0.05 0.30"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.04"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.40"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
</robot>
